# Copy to .env and export the values, or set them in your shell.
# Every value is optional. With nothing set the gate runs fully offline.

# SQLite file that holds drafts, approvals, sends and the audit trail.
SEND_GATE_DB=send_gate.db

# Rule pack (quiet hours, banned phrases, duplicate windows, review date).
SEND_GATE_RULE_PACK=rules/default_pack.json

# Send adapter. Only "mock" ships with this repository.
SEND_GATE_ADAPTER=mock

# If set, approve and reject calls must carry this value in the
# X-Approver-Token header. Leave empty for local demos.
SEND_GATE_APPROVER_TOKEN=
