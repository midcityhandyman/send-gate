# Copy to .env and export the values, or set them in your shell.
# The two tokens are required; the service will not start without them.
# Everything else is optional and the gate runs fully offline.

# Credential for the agent. Sent as the X-Agent-Token header. It can submit
# and edit drafts, re-run checks, send an approved draft and read. It can
# never approve, reject or change the opt out list.
# At least 16 characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SEND_GATE_AGENT_TOKEN=

# Credential for the human approver. Sent as the X-Approver-Token header and
# typed into the approval page. It can approve, reject and change the opt out
# list. It cannot submit or edit drafts. Must differ from the agent token.
# Never give this one to an agent.
SEND_GATE_APPROVER_TOKEN=

# SQLite file that holds drafts, approvals, sends and the audit trail.
SEND_GATE_DB=send_gate.db

# Rule pack (quiet hours, banned phrases, duplicate windows, review date).
# The shipped pack is a sample: its review date is set in the database the
# first time the gate runs. For real use, copy it, set "sample" to false and
# set "reviewed_at" to the day you reviewed it.
SEND_GATE_RULE_PACK=rules/default_pack.json

# Send adapter. Only "mock" ships with this repository.
SEND_GATE_ADAPTER=mock
